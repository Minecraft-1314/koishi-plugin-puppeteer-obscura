{
  "name": "koishi-plugin-puppeteer-obscura",
  "description": "Koishi 浏览器服务，由 Obscura（纯 Rust 无头浏览器）驱动",
  "version": "0.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rimraf lib tsconfig.tsbuildinfo"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "puppeteer",
    "browser",
    "screenshot",
    "pdf",
    "headless",
    "obscura",
    "cdp",
    "浏览器",
    "截图",
    "无头浏览器",
    "渲染",
    "PDF"
  ],
  "devDependencies": {
    "koishi": "^4.18.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "rimraf": "^5.0.5"
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "koishi": {
    "description": {
      "en": "Browser service powered by Obscura, a standalone Rust headless browser, with full puppeteer-compatible page API, self-healing and auto-download",
      "zh": "由纯 Rust 无头浏览器 Obscura 驱动的浏览器服务，提供与官方 puppeteer 插件兼容的完整页面 API，内置断线自愈、进程管控与字体/下载源自动处理"
    },
    "service": {
      "implements": [
        "puppeteer"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minecraft-1314/koishi-plugin-puppeteer-obscura.git"
  },
  "bugs": {
    "url": "https://github.com/Minecraft-1314/koishi-plugin-puppeteer-obscura/issues"
  },
  "homepage": "https://github.com/Minecraft-1314/koishi-plugin-puppeteer-obscura#readme"
}
